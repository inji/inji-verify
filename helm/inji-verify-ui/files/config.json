{
  "verifiableClaims": [
    {
      "logo": "/assets/cert.png",
      "name": "MOSIP ID",
      "type": "MOSIPVerifiableCredential",
      "essential": true,
      "clientIdPrefix":"decentralized_identifier",
      "purpose": "Relying party is requesting your digital ID for the purpose of Self-Authentication",
      "dcqlQuery": {
        "credentials": [
          {
            "id": "mosip_verifiable_credential_id",
            "format": "ldp_vc",
            "meta": {
              "type_values": ["MOSIPVerifiableCredential"]
            }
          }
        ]
      }
    },
    {
      "logo": "/assets/cert.png",
      "name": "Life Insurance",
      "type": "LifeInsuranceCredential",
      "clientIdPrefix":"decentralized_identifier",
      "purpose": "Relying party is requesting your digital ID for the purpose of Self-Authentication",
      "dcqlQuery": {
        "credentials": [
          {
            "id": "life_insurance_credential_id",
            "format": "ldp_vc",
            "meta": {
              "type_values": ["LifeInsuranceCredential"]
            }
          }
        ]
      }
    },
    {
      "logo": "/assets/cert.png",
      "name": "Health Insurance",
      "type": "InsuranceCredential",
      "clientIdPrefix":"pre_registered",
      "purpose": "Relying party is requesting your digital ID for the purpose of Self-Authentication",
      "dcqlQuery": {
        "credentials": [
          {
            "id": "health_insurance_credential_id",
            "format": "ldp_vc",
            "meta": {
              "type_values": ["InsuranceCredential"]
            }
          }
        ]
      }
    },
    {
      "logo": "/assets/cert.png",
      "name": "Mock Identity (SD JWT)",
      "type": "MockVerifiableCredential_SD_JWT",
      "clientIdPrefix":"decentralized_identifier",
      "purpose": "Relying party is requesting your digital ID for the purpose of Self-Authentication",
      "dcqlQuery": {
        "credentials": [
          {
            "id": "mock_identity_sd_jwt_credential_id",
            "format": "vc+sd-jwt",
            "meta": {
              "vct_values": ["MockVerifiableCredential_SD_JWT"]
            }
          }
        ]
      }
    },
    {
      "logo": "/assets/cert.png",
      "name": "Land Registry",
      "type": "LandStatementCredential",
      "clientIdPrefix":"decentralized_identifier",
      "purpose": "Relying party is requesting your digital ID for the purpose of Self-Authentication",
      "dcqlQuery": {
        "credentials": [
          {
            "id": "land_statement_credential_id",
            "format": "ldp_vc",
            "meta": {
              "type_values": ["LandStatementCredential"]
            },
            "claims": [
              {
                "id": "type",
                "path": ["type"]
              }
            ]
          }
        ]
      }
    }
  ],
  "VCRenderOrders": {
    "InsuranceCredentialRenderOrder": [
      "fullName",
      "policyNumber",
      "policyName",
      "policyIssuedOn",
      "policyExpiresOn",
      "benefits",
      "mobile",
      "email",
      "gender",
      "dob"
    ],
    "farmerLandCredentialRenderOrder": [
      "id",
      "farmerId",
      "dvcType",
      {
        "farmerLandDetails": ["farmId", "district", "surveyNumber"]
      }
    ],
    "farmerCredentialRenderOrder": [
      "face",
      "authority",
      "idType",
      "fullName",
      "farmerId",
      "farmerID",
      "gender",
      "phoneNumber",
      "mobileNumber",
      "dateOfBirth",
      "primaryCommodity",
      "landOwnershipType",
      "ownershipType",
      "crops",
      "address",
      "villageOrTown",
      "village",
      "district",
      "state",
      "postalCode",
      "landArea",
      "totalLandArea",
      "primaryCropType",
      "secondaryCropType",
      "season"
    ],
    "MosipVerifiableCredentialRenderOrder": [
      "face",
      "fullName",
      "phone",
      "dateOfBirth",
      "gender",
      "email",
      "city",
      "UIN",
      "VID",
      "addressLine1",
      "province",
      "region",
      "postalCode"
    ],
    "IncomeTaxAccountCredentialRenderOrder": [
      "fullName",
      "tan",
      "gender",
      "dateOfBirth",
      "issuedOn",
      "expiresOn"
    ]
  },
  "WebWallets": [
    {
      "_note": "Replace walletBaseUrl with your own Inji Web Wallet URL. Accepts absolute URLs (https://wallet.example.org) or same-env relative paths (/wallet). Empty string disables the entry.",
      "id": "inji-wallet",
      "name": "Inji Wallet",
      "iconUrl": "/assets/inji-web-wallet-icon.svg",
      "walletBaseUrl": "https://from-install.sh"
    }
  ]
}
